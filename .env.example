# ─────────────────────────────────────────────────────────────
# Habitcraft — environment variables
# Copy this file to `.env` and fill in real values.
# Everything here is read server-side only, except NEXT_PUBLIC_* vars.
# ─────────────────────────────────────────────────────────────

# --- Site ---------------------------------------------------------------
# Your primary domain, no trailing slash. Used for Stripe redirects & emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Where the Store lives. "path" = /store on the same domain (simplest).
# "subdomain" = store.yourdomain.com (set STORE_HOST too).
NEXT_PUBLIC_STORE_MODE="path"
# Only needed if NEXT_PUBLIC_STORE_MODE="subdomain"
STORE_HOST="store.habitcraft.com"
# Shown in the footer and used as the "reply-to" for contact/booking email.
NEXT_PUBLIC_SUPPORT_EMAIL="support@habitcraft.com"

# --- Database (Prisma + PostgreSQL) -------------------------------------
# Free options: Neon (neon.tech) or Supabase (supabase.com).
# Neon gives you a pooled + direct URL; use the pooled one here.
DATABASE_URL="postgresql://user:password@host/habitcraft?sslmode=require"
# Direct (non-pooled) connection, used by `prisma migrate`/`db push`.
DIRECT_URL="postgresql://user:password@host/habitcraft?sslmode=require"

# --- Stripe -------------------------------------------------------------
# From dashboard.stripe.com/apikeys (use test keys while developing).
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# From the webhook you create (see README §Stripe). `stripe listen` prints
# a signing secret for local dev.
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# Price IDs for coaching (create these as Products in Stripe, or leave blank
# to use inline price_data — the code falls back automatically).
STRIPE_PRICE_SESSION=""          # $97 Body Plan Session
STRIPE_PRICE_PROGRAM_FULL=""     # $997 12-week program, pay in full
STRIPE_PRICE_PROGRAM_SPLIT=""    # $349 x3 subscription (optional)

# --- Email (Resend) -----------------------------------------------------
# From resend.com/api-keys. Verify your sending domain first.
RESEND_API_KEY="re_xxx"
# The "from" address on transactional email. Must be on a verified domain.
EMAIL_FROM="Habitcraft <hello@habitcraft.com>"
# Where contact-form and new-booking notifications are sent (your inbox).
EMAIL_TO_OWNER="you@habitcraft.com"

# --- Coach B AI assistant ----------------------------------------------
# Provider adapter — see lib/ai/provider.ts. Default: DeepSeek.
# Options bundled: "deepseek" | "openai" | "groq" | "together"
AI_PROVIDER="deepseek"
AI_API_KEY="sk-xxx"
# Leave blank to use the provider's documented default (see provider.ts).
AI_MODEL=""
# Optional override for a custom OpenAI-compatible base URL.
AI_BASE_URL=""

# --- Affiliate partner (Store) -----------------------------------------
# Base URL for affiliate products. The product's affiliateUrl is appended.
NEXT_PUBLIC_AFFILIATE_BASE="https://partner.example.com"
